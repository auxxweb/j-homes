# Public site origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=

# Optional overrides. Public contact details live in src/data/company.ts.
VITE_PHONE=
VITE_PHONE_DISPLAY=
VITE_EMAIL=

# WhatsApp number in international form, digits only, no plus. Example: 91XXXXXXXXXX
VITE_WHATSAPP=

VITE_INSTAGRAM=
VITE_FACEBOOK=

# Contact form. Web app URL from scripts/enquiry-apps-script.gs (ends in /exec).
VITE_ENQUIRY_ENDPOINT=

# Checklist chatbot. Web app URL from scripts/checklist-apps-script.gs (ends in /exec).
VITE_CHECKLIST_ENDPOINT=
# Same secret as TOKEN in that script. It is visible in the site bundle, so it only blocks casual spam.
VITE_CHECKLIST_TOKEN=

# Journal web app URL from scripts/journal-apps-script.gs (ends in /exec).
VITE_JOURNAL_ENDPOINT=
# Optional. Used only when the journal script is not opened from the sheet itself.
VITE_JOURNAL_SHEET_ID=

# Optional Google Analytics measurement id.
VITE_GA_ID=
