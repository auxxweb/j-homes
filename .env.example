# Public site origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=

# Contact details. Leave blank until the real values are available.
# Do not invent a number here.
VITE_PHONE=
VITE_PHONE_DISPLAY=
VITE_EMAIL=

# WhatsApp number in international form, digits only, no plus. Example: 91XXXXXXXXXX
VITE_WHATSAPP=

VITE_INSTAGRAM=
VITE_FACEBOOK=

# Optional POST endpoint for enquiries. JSON body, no API key in the frontend.
VITE_ENQUIRY_ENDPOINT=

# Optional Google Analytics measurement id.
VITE_GA_ID=
